# LA TAUPE — Variables d'environnement
# Copier ce fichier vers .env et remplir les valeurs

# ─── OpenAI (obligatoire pour Palier 2) ───
OPENAI_API_KEY=sk-votre-cle-api-ici
OPENAI_MODEL=gpt-4o-mini

# ─── Backend (Kévin) — sera utilisé aux paliers suivants ───
# DATABASE_URL=postgresql://user:pass@localhost:5432/la_taupe
# REDIS_URL=redis://localhost:6379/0
# API_HOST=0.0.0.0
# API_PORT=8000

# ─── Frontend (Niko) — sera utilisé aux paliers suivants ───
# FRONTEND_URL=http://localhost:3000

# ─── Sécurité / Détection (Yo) ───
DETECTION_MODEL=gpt-4o-mini
DETECTION_TEMPERATURE=0.0
MAX_DOC_CHARS=8000
SEARCH_TOP_K=5

# ─── Logging ───
LOG_LEVEL=INFO