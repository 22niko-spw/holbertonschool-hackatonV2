# René LA TAUPE — Variables d'environnement
# Copier ce fichier vers .env et remplir les valeurs

# ─── Anthropic (obligatoire pour Palier 2) ───
ANTHROPIC_API_KEY=votre-cle-api-ici
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# Modèle utilisé par le détecteur d'injection (optionnel, sinon = ANTHROPIC_MODEL)
DETECTION_MODEL=claude-haiku-4-5-20251001

# ─── Backend (Kévin) ───
# Port d'écoute du serveur Flask (optionnel)
PORT=5000
# Fichier SQLite du corpus/rapports (optionnel)
DATABASE_PATH=la_taupe.db
# Nombre de passages remontés par recherche dans le corpus (optionnel)
SEARCH_TOP_K=5
# Taille max d'upload en Mo pour /ingest (optionnel)
MAX_UPLOAD_MB=20

# ─── Frontend (Niko) — sera utilisé aux paliers suivants ───
# FRONTEND_URL=http://localhost:3000

# ─── Sécurité / Détection (Yo) ───
DETECTION_TEMPERATURE=0.0
MAX_DOC_CHARS=8000

# ─── Logging ───
LOG_LEVEL=INFO
